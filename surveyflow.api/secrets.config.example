<?xml version="1.0" encoding="utf-8"?>
<!--
  Template. Copy to secrets.config and fill in real values for the
  environment you're setting up.

  Dev:  App:PublicBaseUrl = http://localhost:5173
        Cors:AllowedOrigins = http://localhost:5173
  Prod: App:PublicBaseUrl = https://surveyflow.periscopeiq.com
        Cors:AllowedOrigins = (omit or set to the React origin if cross-origin)
-->
<appSettings>
  <add key="Resend:ApiKey" value="" />
  <add key="Resend:FromAddress" value="SurveyFlow &lt;surveys@yourdomain.com&gt;" />
  <add key="App:PublicBaseUrl" value="" />
  <add key="Cors:AllowedOrigins" value="" />

  <!-- OpenAI for AI features (TextAnalyticsReport, save-to-library quality
       analysis, follow-up questions, sentiment). Get a key at
       https://platform.openai.com/api-keys. Default model is gpt-4o-mini. -->
  <add key="Ai:OpenAIKey" value="" />
  <add key="Ai:Model" value="gpt-4o-mini" />
  <!-- Shared secret used by the sentiment cron + any future cron jobs. -->
  <add key="Jobs:ApiKey" value="" />
</appSettings>
